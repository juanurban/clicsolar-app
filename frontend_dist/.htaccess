RewriteEngine On

# Si el usuario navega a /login sin el .html, sirve login.html
RewriteRule ^login$ login.html [L]

# Si el archivo o directorio existe, sírvelo directamente (para assets en /static)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Para cualquier otra ruta que no sea un archivo real, sirve index.html (SPA routing)
RewriteRule ^ index.html [L]
